# SpeakUp AI - Environment Configuration
# Get a free Groq API key from https://console.groq.com/keys and paste it below:
GROQ_API_KEY=your_groq_api_key_here

# (Optional) Google Gemini API Key:
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Secret key for Flask session encryption in production:
SECRET_KEY=your_random_production_secret_key_here

# (Optional) Cloud MySQL Database URL (e.g. TiDB Cloud, Aiven, or Clever Cloud):
# Format: mysql://user:password@host:port/database_name?ssl-mode=REQUIRED
DATABASE_URL=

# Or individual MySQL environment variables:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
